page { width: 100%; max-width: 100vw; overflow-x: hidden; background: #fff3f7; }
view, button, input, text { box-sizing: border-box; }
.app-shell { width: 100%; max-width: 100vw; min-height: 100vh; overflow-x: hidden; padding-bottom: 158rpx; color: #553f4b; background: linear-gradient(180deg, #fff5f8 0%, #fff9fb 42%, #fef7fc 100%); font-family: "Arial Rounded MT Bold", "PingFang SC", "Microsoft YaHei", sans-serif; }
button { margin: 0; line-height: 1; }
.main-content { width: 100%; padding: 0 30rpx; overflow-x: hidden; }

.page-head, .trend-head { width: 100%; padding: 34rpx 40rpx 30rpx; display: flex; align-items: center; justify-content: space-between; }
.home-head { padding-top: 40rpx; }
.date-label { margin-bottom: 10rpx; color: #ed84a9; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }
.page-title { max-width: 550rpx; color: #5a4050; font-size: 41rpx; line-height: 1.32; font-weight: 800; }
.avatar-button { width: 82rpx; height: 82rpx; padding: 0; display: grid; place-items: center; flex: 0 0 82rpx; border: 3rpx solid #fff; border-radius: 26rpx; background: #ffd7e5; box-shadow: 0 8rpx 0 #f6b9ce; }
.mascot-face { position: relative; width: 54rpx; height: 45rpx; border-radius: 48% 48% 44% 44%; background: #fff; }
.mascot-face .ear { position: absolute; width: 17rpx; height: 28rpx; top: -18rpx; border-radius: 60% 60% 25% 25%; background: #fff; }.mascot-face .ear.left { left: 7rpx; transform: rotate(-8deg); }.mascot-face .ear.right { right: 7rpx; transform: rotate(8deg); }
.mascot-face .eye { position: absolute; width: 5rpx; height: 7rpx; top: 18rpx; border-radius: 50%; background: #765666; }.mascot-face .eye.left { left: 15rpx; }.mascot-face .eye.right { right: 15rpx; }.mascot-face .mouth { position: absolute; width: 9rpx; height: 5rpx; left: 23rpx; top: 29rpx; border-bottom: 3rpx solid #f08bac; border-radius: 50%; }

.weight-panel { position: relative; width: 100%; padding: 38rpx 36rpx 34rpx; overflow: hidden; border: 3rpx solid #fff; border-radius: 32rpx; color: #664657; background: linear-gradient(135deg, #ffe0ea 0%, #fff0df 52%, #e8dcff 100%); box-shadow: 0 14rpx 0 #f5c4d6, 0 23rpx 35rpx rgba(218,129,162,.12); }
.weight-panel:before { content: ""; position: absolute; width: 150rpx; height: 150rpx; right: -37rpx; top: -47rpx; border: 22rpx solid rgba(255,255,255,.38); border-radius: 50%; }.weight-panel:after { content: ""; position: absolute; width: 68rpx; height: 68rpx; right: 90rpx; top: 55rpx; border-radius: 50%; background: rgba(255,255,255,.34); }
.sparkle { position: absolute; z-index: 1; color: rgba(255,255,255,.95); font-weight: 800; }.sparkle-one { right: 72rpx; top: 35rpx; font-size: 33rpx; }.sparkle-two { right: 28rpx; top: 111rpx; font-size: 28rpx; }.cloud { position: absolute; width: 120rpx; height: 34rpx; border-radius: 40rpx 40rpx 13rpx 13rpx; background: rgba(255,255,255,.27); }.cloud:before, .cloud:after { content: ""; position: absolute; border-radius: 50%; background: inherit; }.cloud:before { width: 47rpx; height: 47rpx; left: 18rpx; top: -23rpx; }.cloud:after { width: 62rpx; height: 62rpx; right: 13rpx; top: -35rpx; }.cloud-one { right: -25rpx; bottom: 90rpx; }.cloud-two { left: -55rpx; top: 154rpx; transform: scale(.7); opacity: .55; }
.panel-top { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }.panel-kicker { color: #d8749b; font-size: 16rpx; font-weight: 800; letter-spacing: 1rpx; }.panel-label { margin-top: 7rpx; color: #79596a; font-size: 23rpx; font-weight: 800; }.change-badge { position: relative; z-index: 2; padding: 11rpx 17rpx; border: 2rpx solid #fff; border-radius: 18rpx; color: #d76291; background: rgba(255,255,255,.72); font-size: 19rpx; font-weight: 800; }
.weight-row { position: relative; z-index: 2; height: 132rpx; display: flex; align-items: flex-end; }.weight-number { font-family: "Arial Rounded MT Bold", "Helvetica Neue", sans-serif; font-size: 104rpx; line-height: 1.04; font-weight: 800; }.weight-number.tone-goal { color: #67af97; }.weight-number.tone-close { color: #e5a173; }.weight-number.tone-1 { color: #ea927b; }.weight-number.tone-2 { color: #ed7e80; }.weight-number.tone-3 { color: #ed6e83; }.weight-number.tone-4 { color: #e65f7d; }.weight-number.tone-5 { color: #d94f70; }.weight-unit { margin: 0 0 18rpx 12rpx; color: #a27289; font-size: 27rpx; font-weight: 700; }
.goal-row { position: relative; z-index: 2; display: flex; justify-content: space-between; color: #956f82; font-size: 19rpx; }.goal-track { position: relative; z-index: 2; height: 12rpx; margin: 16rpx 0 12rpx; overflow: hidden; border: 2rpx solid rgba(255,255,255,.8); border-radius: 99rpx; background: rgba(255,255,255,.5); }.goal-progress { width: 57%; height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #ff91b7, #ffb989); }.goal-footer { position: relative; z-index: 2; display: flex; justify-content: space-between; color: #ac8296; font-size: 18rpx; }
.weight-add { position: relative; z-index: 2; width: calc(100% + 72rpx); height: 80rpx; margin: 28rpx -36rpx -34rpx; padding: 0; display: flex; align-items: center; justify-content: center; gap: 9rpx; border: 0; border-top: 2rpx solid rgba(255,255,255,.75); border-radius: 0; color: #d65386; background: rgba(255,255,255,.55); font-size: 22rpx; font-weight: 800; line-height: 80rpx; }.weight-add text { font-size: 22rpx; font-weight: 800; }.weight-add .add-mark { font-size: 31rpx; font-weight: 500; }

.section-head { margin: 50rpx 6rpx 22rpx; display: flex; align-items: flex-end; justify-content: space-between; }.section-head.compact { margin-top: 46rpx; }.section-title { color: #604857; font-size: 31rpx; line-height: 1.25; font-weight: 800; }.section-subtitle { margin-top: 7rpx; color: #a58a98; font-size: 19rpx; }.section-sticker { min-width: 60rpx; height: 46rpx; display: grid; place-items: center; padding: 0 12rpx; border: 2rpx solid #fff; border-radius: 16rpx; color: #d85d8c; background: #ffd9e6; box-shadow: 0 5rpx 0 #f2bbcf; font-size: 16rpx; font-weight: 800; transform: rotate(4deg); }.section-sticker.soft { color: #8170c6; background: #e4dcff; box-shadow: 0 5rpx 0 #d0c3ef; transform: rotate(-3deg); }.section-rule { width: 125rpx; height: 9rpx; border-radius: 99rpx; background: repeating-linear-gradient(90deg, #ffb2cc 0 15rpx, transparent 15rpx 22rpx); }

.daily-panel { width: 100%; min-height: 272rpx; display: flex; align-items: center; padding: 28rpx 30rpx; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.calorie-side { width: 230rpx; display: flex; flex-direction: column; align-items: center; }.calorie-ring { width: 162rpx; height: 162rpx; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(#ff87ae 0 78%, #f7e6ed 78% 100%); }.calorie-inner { width: 128rpx; height: 128rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #fff; }.calorie-main { font-family: "Arial Rounded MT Bold", sans-serif; font-size: 39rpx; line-height: 1; font-weight: 800; }.calorie-unit { margin-top: 8rpx; color: #ac93a0; font-size: 17rpx; }.calorie-caption { margin-top: 15rpx; color: #a9909d; font-size: 18rpx; }.daily-metrics { flex: 1; padding-left: 25rpx; border-left: 2rpx dashed #f3dce5; }.metric-row { height: 89rpx; display: flex; align-items: center; }.metric-divider { height: 2rpx; margin-left: 83rpx; background: #f7e8ee; }.metric-icon { width: 60rpx; height: 60rpx; display: grid; place-items: center; flex: 0 0 60rpx; border-radius: 20rpx; }.water-icon { background: #daf3f1; }.step-icon { background: #ffe4d9; }.drop-shape { width: 18rpx; height: 25rpx; border-radius: 50% 50% 55% 55%; background: #66b7ae; transform: rotate(45deg); }.step-shape { width: 28rpx; height: 18rpx; border: 5rpx solid #eb8c76; border-top: 0; border-radius: 0 0 14rpx 14rpx; transform: rotate(-20deg); }.metric-copy { flex: 1; margin-left: 18rpx; }.metric-label { color: #a08a96; font-size: 18rpx; }.metric-value { margin-top: 6rpx; color: #5f4855; font-size: 28rpx; font-weight: 800; }.metric-value text { color: #ac95a1; font-size: 17rpx; font-weight: 500; }.metric-goal { color: #5eafa4; font-size: 20rpx; font-weight: 800; }.metric-goal.coral { color: #ec8a73; }

.quick-panel { width: 100%; min-width: 0; display: flex; flex-direction: row; align-items: stretch; padding: 25rpx 8rpx 23rpx; overflow: hidden; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.quick-action { position: relative; width: 25%; min-width: 25%; max-width: 25%; height: 143rpx; margin: 0 !important; padding: 0 5rpx !important; display: flex; flex: 1 1 25%; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; overflow: hidden; border: 0; color: #785c6c; background: transparent; font-size: 17rpx; line-height: 1.2; font-weight: 700; }.quick-action::after { display: none; }.quick-action + .quick-action:before { content: ""; position: absolute; width: 2rpx; height: 72rpx; left: 0; top: 22rpx; background: #f5e7ed; }.action-icon { width: 72rpx; height: 72rpx; display: grid; place-items: center; border-radius: 24rpx; }.meal-icon { background: #ffdce8; }.water-action { background: #dcf3f1; }.sport-action { background: #e7f2d9; }.weight-action { background: #e8e0fa; }
.mini-character { position: relative; width: 47rpx; height: 38rpx; border-radius: 48% 48% 45% 45%; background: #fff; }.mini-character .mini-ear { position: absolute; }.mini-character .mini-eye { position: absolute; width: 4rpx; height: 6rpx; top: 17rpx; border-radius: 50%; background: #715563; }.mini-character .mini-eye.left { left: 13rpx; }.mini-character .mini-eye.right { right: 13rpx; }.bunny .mini-ear { width: 14rpx; height: 25rpx; top: -16rpx; border-radius: 60% 60% 25% 25%; background: #fff; }.bunny .mini-ear.left { left: 6rpx; transform: rotate(-8deg); }.bunny .mini-ear.right { right: 6rpx; transform: rotate(8deg); }.bear .mini-ear { width: 15rpx; height: 15rpx; top: -5rpx; border: 4rpx solid #fff; border-radius: 50%; background: #e6bd79; }.bear .mini-ear.left { left: 0; }.bear .mini-ear.right { right: 0; }.bear { background: #ffe3a6; }.mochi { height: 35rpx; border-radius: 50% 50% 40% 40%; background: #d9edc8; }.kitty { background: #fff; }.kitty .mini-ear { width: 18rpx; height: 18rpx; top: -6rpx; background: #fff; transform: rotate(45deg); }.kitty .mini-ear.left { left: 2rpx; }.kitty .mini-ear.right { right: 2rpx; }

.record-panel { width: 100%; padding: 0 28rpx; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.record-item { min-height: 120rpx; display: flex; align-items: center; }.record-item + .record-item { border-top: 2rpx dashed #f3e1e9; }.record-mark { width: 49rpx; height: 49rpx; display: grid; place-items: center; flex: 0 0 49rpx; border-radius: 17rpx; background: #ffe0e9; }.record-mark.water { background: #dcf3f1; }.record-mark.walk { background: #e7f2d9; }.record-mark.scale { background: #e8e0fa; }.record-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: #ee7da5; }.record-mark.water .record-dot { background: #66b7ae; }.record-mark.walk .record-dot { background: #8ab56b; }.record-mark.scale .record-dot { background: #9380ce; }.record-copy { flex: 1; min-width: 0; margin-left: 20rpx; }.record-title { overflow: hidden; color: #654d5b; font-size: 23rpx; font-weight: 800; white-space: nowrap; text-overflow: ellipsis; }.record-time { margin-top: 7rpx; color: #ae98a4; font-size: 18rpx; }.record-value { color: #967487; font-size: 20rpx; font-weight: 800; }

.trend-head { display: block; padding-bottom: 29rpx; }.trend-title-row { display: flex; align-items: center; justify-content: space-between; }.trend-title { font-size: 48rpx; }.trend-summary { margin-top: 14rpx; color: #a18996; font-size: 21rpx; }.trend-summary text { color: #e35f8d; font-weight: 800; }.circle-add { width: 68rpx; height: 68rpx; padding: 0; border: 3rpx solid #fff; border-radius: 23rpx; color: #d95888; background: #ffd9e7; box-shadow: 0 6rpx 0 #f0b8cd; font-size: 38rpx; font-weight: 500; line-height: 65rpx; }.trend-content { padding-top: 8rpx; }.period-control { height: 72rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6rpx; padding: 7rpx; border-radius: 24rpx; background: #f2e4ec; }.period-button { height: 58rpx; padding: 0; border-radius: 19rpx; color: #a18896; background: transparent; font-size: 20rpx; line-height: 58rpx; }.period-button.active { color: #d85687; background: #fff; box-shadow: 0 4rpx 0 #ebcbd8; font-weight: 800; }
.chart-panel { margin-top: 24rpx; padding: 31rpx 28rpx 25rpx; overflow: hidden; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.chart-overview { display: flex; align-items: flex-end; justify-content: space-between; }.chart-label { color: #a38b98; font-size: 19rpx; }.chart-current { margin-top: 8rpx; font-family: "Arial Rounded MT Bold", sans-serif; font-size: 49rpx; line-height: 1; font-weight: 800; }.chart-current.tone-goal { color: #67af97; }.chart-current.tone-close { color: #e5a173; }.chart-current.tone-1 { color: #ea927b; }.chart-current.tone-2 { color: #ed7e80; }.chart-current.tone-3 { color: #ed6e83; }.chart-current.tone-4 { color: #e65f7d; }.chart-current.tone-5 { color: #d94f70; }.chart-current text { color: #aa94a0; font-size: 20rpx; font-weight: 500; }.chart-delta { display: flex; align-items: center; gap: 12rpx; padding-bottom: 3rpx; }.delta-arrow { width: 42rpx; height: 42rpx; display: grid; place-items: center; border-radius: 50%; color: #55a99d; background: #dcf3f0; font-size: 23rpx; font-weight: 800; }.delta-value { color: #55a99d; font-size: 22rpx; font-weight: 800; }.delta-label { margin-top: 4rpx; color: #ad98a3; font-size: 17rpx; }.chart-area { position: relative; height: 230rpx; margin: 45rpx 14rpx 0; }.grid-line { position: absolute; left: 0; right: 0; height: 2rpx; background: #f6e8ee; }.grid-one { top: 30rpx; }.grid-two { top: 90rpx; }.grid-three { top: 150rpx; }.grid-four { top: 210rpx; }.chart-segment { position: absolute; height: 6rpx; border-radius: 99rpx; background: #ef7ea6; transform-origin: 0 50%; z-index: 2; }.chart-point { position: absolute; width: 14rpx; height: 14rpx; margin: -4rpx 0 0 -7rpx; border: 4rpx solid #fff; border-radius: 50%; background: #ef7ea6; box-shadow: 0 0 0 3rpx #ef7ea6; z-index: 3; }.chart-point.latest { width: 18rpx; height: 18rpx; margin-top: -6rpx; background: #806fc4; box-shadow: 0 0 0 3rpx #806fc4; }.point-bubble { position: absolute; right: -11rpx; bottom: 30rpx; min-width: 66rpx; padding: 9rpx 13rpx; border-radius: 14rpx; color: #fff; background: #806fc4; text-align: center; font-size: 20rpx; font-weight: 800; }.point-bubble:after { content: ""; position: absolute; right: 10rpx; bottom: -9rpx; border-width: 9rpx 7rpx 0; border-style: solid; border-color: #806fc4 transparent transparent; }.chart-labels { margin: 2rpx 4rpx 0; display: flex; justify-content: space-between; color: #b09aa5; font-size: 16rpx; }
.trend-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 22rpx; padding: 27rpx 0; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.trend-stat { padding: 0 20rpx; text-align: center; }.trend-stat + .trend-stat { border-left: 2rpx dashed #f2e1e8; }.stat-label { color: #a48c98; font-size: 18rpx; }.stat-number { margin-top: 10rpx; color: #624a58; font-size: 27rpx; font-weight: 800; }.stat-number text { color: #aa94a0; font-size: 17rpx; font-weight: 500; }.trend-section { margin-top: 43rpx; }.weight-history { padding: 5rpx 27rpx; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.history-row { min-height: 124rpx; display: flex; align-items: center; }.history-row + .history-row { border-top: 2rpx dashed #f3e2e9; }.history-date { width: 72rpx; text-align: center; }.history-day { color: #e26491; font-size: 29rpx; line-height: 1; font-weight: 800; }.history-month { margin-top: 6rpx; color: #b09aa5; font-size: 17rpx; }.history-line { width: 40rpx; display: grid; place-items: center; }.history-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #f08bad; }.history-copy { flex: 1; }.history-weight { color: #624a58; font-size: 24rpx; font-weight: 800; }.history-note { margin-top: 7rpx; color: #ad98a3; font-size: 18rpx; }.history-change { color: #9d8994; font-size: 20rpx; font-weight: 800; }.history-change.down { color: #5eaa9e; }

.profile-panel { padding: 55rpx 30rpx 36rpx; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; text-align: center; }.profile-avatar { width: 120rpx; height: 120rpx; margin: 0 auto; display: grid; place-items: center; border: 4rpx solid #fff; border-radius: 38rpx; background: #ffd9e7; box-shadow: 0 8rpx 0 #efbcd0; }.profile-name { margin-top: 23rpx; color: #604756; font-size: 31rpx; font-weight: 800; }.profile-copy { margin-top: 8rpx; color: #a68f9b; font-size: 20rpx; }.profile-data { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 36rpx; padding-top: 30rpx; border-top: 2rpx dashed #f0dde5; }.profile-data view + view { border-left: 2rpx dashed #f0dde5; }.profile-data text { display: block; color: #df608d; font-size: 31rpx; font-weight: 800; }.profile-data label { display: block; margin-top: 6rpx; color: #aa94a0; font-size: 18rpx; }.settings-panel { margin-top: 22rpx; padding: 0 28rpx; border: 3rpx solid #fff; border-radius: 28rpx; background: #fff; box-shadow: 0 11rpx 0 #f5dbe5; }.settings-panel button { height: 102rpx; padding: 0; display: flex; align-items: center; justify-content: space-between; color: #674f5d; background: transparent; font-size: 22rpx; font-weight: 700; }.settings-panel button + button { border-top: 2rpx dashed #f1dfe7; }.settings-panel button text:last-child { color: #d9a5b9; font-size: 32rpx; }

.bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; width: 100%; height: 132rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 11rpx 76rpx calc(11rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #f4d7e3; background: rgba(255,250,252,.98); box-shadow: 0 -9rpx 28rpx rgba(218,139,169,.08); z-index: 10; }.nav-button { height: 92rpx; padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9rpx; color: #b49ca8; background: transparent; font-size: 18rpx; }.nav-glyph { position: relative; width: 42rpx; height: 34rpx; }.home-glyph:before { content: ""; position: absolute; width: 25rpx; height: 25rpx; left: 7rpx; top: 6rpx; border: 4rpx solid currentColor; border-top: 0; border-radius: 7rpx; }.home-glyph:after { content: ""; position: absolute; width: 23rpx; height: 23rpx; left: 8rpx; top: 0; border-left: 4rpx solid currentColor; border-top: 4rpx solid currentColor; transform: rotate(45deg); border-radius: 4rpx; }.chart-glyph { display: flex; align-items: flex-end; justify-content: center; gap: 5rpx; }.chart-glyph view { width: 7rpx; border-radius: 7rpx; background: currentColor; }.chart-glyph view:nth-child(1) { height: 15rpx; }.chart-glyph view:nth-child(2) { height: 27rpx; }.chart-glyph view:nth-child(3) { height: 20rpx; }.user-glyph:before { content: ""; position: absolute; width: 12rpx; height: 12rpx; left: 13rpx; top: 1rpx; border: 4rpx solid currentColor; border-radius: 50%; }.user-glyph:after { content: ""; position: absolute; width: 29rpx; height: 16rpx; left: 4rpx; bottom: 0; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 22rpx 22rpx 0 0; }.nav-button.active { color: #e45f8e; font-weight: 800; }

.modal-backdrop { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 34rpx; background: rgba(82,52,68,.34); z-index: 30; }
.modal { width: 100%; max-width: 650rpx; max-height: 88vh; padding: 32rpx; overflow-y: auto; border: 3rpx solid rgba(255,255,255,.9); border-radius: 32rpx; background: #fff8fb; box-shadow: 0 24rpx 70rpx rgba(151,69,105,.22); }
.modal-head { margin-bottom: 27rpx; display: flex; align-items: center; justify-content: space-between; }
.modal-eyebrow { margin-bottom: 6rpx; color: #e27ca2; font-size: 18rpx; font-weight: 700; }
.modal-title { color: #614958; font-size: 34rpx; font-weight: 800; }
.close-button { width: 54rpx; height: 54rpx; padding: 0; border-radius: 50%; color: #d27498; background: #ffe0eb; font-size: 34rpx; line-height: 51rpx; }
.field { width: 100%; margin-bottom: 22rpx; }
.field-label { margin: 0 0 11rpx 2rpx; color: #816877; font-size: 20rpx; font-weight: 700; }
.field-input { width: 100%; height: 82rpx; padding: 0 23rpx; border: 3rpx solid #f5dbe5; border-radius: 20rpx; color: #604a57; background: #fff; font-size: 23rpx; }
.input-with-unit { position: relative; width: 100%; }
.input-with-unit text { position: absolute; right: 25rpx; top: 28rpx; color: #ad94a1; font-size: 21rpx; }
.amount-input { padding-right: 100rpx; }
.weight-modal { max-width: 610rpx; }
.weight-entry { width: 100%; margin: 4rpx 0 22rpx; padding: 24rpx 22rpx 19rpx; border: 3rpx solid #f6d9e5; border-radius: 25rpx; background: #fff; }
.weight-entry-label { color: #836777; font-size: 20rpx; font-weight: 800; text-align: center; }
.weight-picker-shell { position: relative; width: 100%; height: 286rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.weight-picker { width: 330rpx; height: 264rpx; margin-right: 50rpx; }
.picker-item { height: 88rpx; display: flex; align-items: center; color: #bca7b1; font-family: "Arial Rounded MT Bold", "Helvetica Neue", sans-serif; font-size: 38rpx; line-height: 88rpx; font-weight: 700; }
.picker-item.selected { color: #df5f8d; font-size: 54rpx; font-weight: 800; }
.picker-whole { justify-content: flex-end; padding-right: 5rpx; }
.picker-decimal { justify-content: flex-start; padding-left: 5rpx; }
.picker-selection { position: absolute; left: 49rpx; right: 49rpx; top: 99rpx; height: 88rpx; border-top: 3rpx solid #f28ab0; border-bottom: 3rpx solid #f28ab0; background: rgba(255,224,235,.23); pointer-events: none; }
.picker-unit { position: absolute; right: 51rpx; top: 128rpx; color: #d76691; font-size: 24rpx; line-height: 40rpx; font-weight: 800; }
.weight-entry-tip { color: #ad96a2; font-size: 17rpx; text-align: center; }
.submit-button { width: 100%; height: 84rpx; margin-top: 5rpx; padding: 0; border: 3rpx solid #fff; border-radius: 22rpx; color: #fff; background: linear-gradient(90deg, #f06f9e, #f791b5); box-shadow: 0 7rpx 0 #d95686; font-size: 23rpx; font-weight: 800; line-height: 78rpx; }

/* Trend page rhythm: one compact chart module followed by a tighter history list. */
.trend-head { padding-bottom: 18rpx; }
.trend-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.trend-title { max-width: 450rpx; font-size: 39rpx; line-height: 1.2; }
.trend-summary { margin-top: 11rpx; font-size: 20rpx; }
.circle-add { width: 112rpx; height: 62rpx; padding: 0; display: flex; align-items: center; justify-content: center; gap: 5rpx; flex: 0 0 112rpx; border-radius: 22rpx; font-size: 19rpx; line-height: 58rpx; }
.circle-add text:first-child { font-size: 28rpx; }
.trend-content { padding-top: 4rpx; }
.chart-panel { margin-top: 16rpx; padding: 25rpx 26rpx 20rpx; border-radius: 28rpx; box-shadow: 0 9rpx 0 #f5dbe5; }
.chart-topline { display: flex; align-items: flex-end; justify-content: space-between; }
.chart-overview { flex: 1; }
.chart-current { font-size: 46rpx; }
.chart-delta { gap: 9rpx; }
.delta-arrow { width: 38rpx; height: 38rpx; font-size: 21rpx; }
.delta-value { font-size: 20rpx; }
.delta-label { font-size: 16rpx; }
.period-control { width: 100%; height: 62rpx; margin-top: 21rpx; padding: 5rpx; gap: 5rpx; border-radius: 17rpx; }
.period-button { height: 52rpx; border-radius: 14rpx; font-size: 18rpx; line-height: 52rpx; }
.chart-area { height: 210rpx; margin-top: 29rpx; }
.trend-stats { margin-top: 16rpx; padding: 20rpx 0; border-radius: 24rpx; box-shadow: 0 8rpx 0 #f5dbe5; }
.stat-label { font-size: 17rpx; }.stat-number { margin-top: 7rpx; font-size: 24rpx; }
.trend-section { margin-top: 34rpx; }
.weight-history { padding: 4rpx 24rpx; border-radius: 24rpx; box-shadow: 0 8rpx 0 #f5dbe5; }
.history-row { min-height: 104rpx; }.history-date { width: 62rpx; }.history-day { font-size: 27rpx; }.history-month { font-size: 16rpx; }.history-line { width: 30rpx; }.history-weight { font-size: 22rpx; }.history-note { font-size: 16rpx; }.history-change { font-size: 19rpx; }

/* Final trend composition: clear header, one hero chart, compact timeline. */
.trend-head { padding: 26rpx 40rpx 12rpx; }
.trend-heading { gap: 12rpx; }
.trend-title { max-width: 500rpx; font-size: 38rpx; line-height: 1.22; }
.trend-summary { margin-top: 8rpx; font-size: 18rpx; }
.circle-add { width: 58rpx; height: 58rpx; flex: 0 0 58rpx; border-radius: 50%; font-size: 34rpx; line-height: 54rpx; }
.trend-content { padding-top: 0; }
.chart-panel { margin-top: 12rpx; padding: 22rpx 22rpx 0; border-radius: 25rpx; box-shadow: 0 8rpx 0 #f5dbe5; }
.chart-topline { min-height: 84rpx; }
.chart-label { font-size: 17rpx; }.chart-current { margin-top: 3rpx; font-size: 44rpx; }
.chart-delta { gap: 7rpx; }.delta-arrow { width: 34rpx; height: 34rpx; font-size: 19rpx; }.delta-value { font-size: 18rpx; }.delta-label { font-size: 15rpx; }
.period-control { height: 54rpx; margin-top: 14rpx; padding: 4rpx; border-radius: 14rpx; }.period-button { height: 46rpx; border-radius: 11rpx; font-size: 17rpx; line-height: 46rpx; }
.chart-area { height: 188rpx; margin: 24rpx 8rpx 0; }.grid-one { top: 24rpx; }.grid-two { top: 76rpx; }.grid-three { top: 128rpx; }.grid-four { top: 180rpx; }.chart-labels { padding-bottom: 18rpx; font-size: 14rpx; }
.trend-stats { margin: 0 -22rpx; padding: 17rpx 0; border-width: 0; border-top: 2rpx solid #f7e5ec; border-radius: 0 0 25rpx 25rpx; box-shadow: none; }.trend-stat { padding: 0 12rpx; }.stat-label { font-size: 16rpx; }.stat-number { margin-top: 5rpx; font-size: 21rpx; }
.trend-section { margin-top: 27rpx; margin-bottom: 14rpx; }.trend-section .section-title { font-size: 28rpx; }.trend-section .section-subtitle { margin-top: 4rpx; font-size: 17rpx; }
.weight-history { padding: 0 20rpx; border-radius: 23rpx; box-shadow: 0 8rpx 0 #f5dbe5; }.history-row { min-height: 92rpx; }.history-date { width: 52rpx; }.history-day { font-size: 24rpx; }.history-month { margin-top: 3rpx; font-size: 14rpx; }.history-line { width: 25rpx; }.history-dot { width: 8rpx; height: 8rpx; }.history-weight { font-size: 20rpx; }.history-note { margin-top: 3rpx; font-size: 14rpx; }.history-change { font-size: 17rpx; }
