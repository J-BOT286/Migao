<view class="app-shell">
  <block wx:if="{{activeNav === 'home'}}">
    <view class="page-head home-head">
      <view>
        <view class="date-label">DAY 18 · 轻盈打卡中</view>
        <view class="page-title">今天也要可爱地变轻呀</view>
      </view>
      <button class="avatar-button" data-action="profile" bindtap="actionToast"><view class="mascot-face mascot-bunny"><view class="ear left"></view><view class="ear right"></view><view class="eye left"></view><view class="eye right"></view><view class="mouth"></view></view></button>
    </view>

    <view class="main-content">
      <view class="weight-panel">
        <view class="sparkle sparkle-one">✦</view><view class="sparkle sparkle-two">♡</view><view class="cloud cloud-one"></view><view class="cloud cloud-two"></view>
        <view class="panel-top">
          <view><view class="panel-kicker">TODAY'S WEIGHT</view><view class="panel-label">今天的体重</view></view>
          <view class="change-badge">较上周 -0.7 kg</view>
        </view>
        <view class="weight-row"><text class="weight-number {{weightTone}}">{{weight}}</text><text class="weight-unit">kg</text></view>
        <view class="goal-row"><text>距离目标还有 4.6 kg</text><text>57%</text></view>
        <view class="goal-track"><view class="goal-progress"></view></view>
        <view class="goal-footer"><text>开始 62.0</text><text>目标 54.0</text></view>
        <button class="weight-add" data-type="weight" bindtap="openModal"><text class="add-mark">＋</text><text>记录今天的体重</text></button>
      </view>

      <view class="section-head"><view><view class="section-title">今天怎么样</view><view class="section-subtitle">不用满分，开心坚持就好</view></view><view class="section-sticker">GOOD</view></view>
      <view class="daily-panel">
        <view class="calorie-side">
          <view class="calorie-ring"><view class="calorie-inner"><text class="calorie-main">1280</text><text class="calorie-unit">千卡</text></view></view>
          <view class="calorie-caption">目标 1650 千卡</view>
        </view>
        <view class="daily-metrics">
          <view class="metric-row"><view class="metric-icon water-icon"><view class="drop-shape"></view></view><view class="metric-copy"><view class="metric-label">饮水</view><view class="metric-value">{{water}} <text>ml</text></view></view><view class="metric-goal">60%</view></view>
          <view class="metric-divider"></view>
          <view class="metric-row"><view class="metric-icon step-icon"><view class="step-shape"></view></view><view class="metric-copy"><view class="metric-label">步数</view><view class="metric-value">6842 <text>步</text></view></view><view class="metric-goal coral">68%</view></view>
        </view>
      </view>

      <view class="section-head compact"><view><view class="section-title">和小伙伴一起记录</view></view><view class="section-rule"></view></view>
      <view class="quick-panel">
        <button class="quick-action" data-type="meal" bindtap="openModal"><view class="action-icon meal-icon"><view class="mini-character bunny"><view class="mini-ear left"></view><view class="mini-ear right"></view><view class="mini-eye left"></view><view class="mini-eye right"></view></view></view><text>莓莓兔 · 饮食</text></button>
        <button class="quick-action" data-type="water" bindtap="openModal"><view class="action-icon water-action"><view class="mini-character bear"><view class="mini-ear left"></view><view class="mini-ear right"></view><view class="mini-eye left"></view><view class="mini-eye right"></view></view></view><text>布丁熊 · 喝水</text></button>
        <button class="quick-action" data-type="sport" bindtap="openModal"><view class="action-icon sport-action"><view class="mini-character mochi"><view class="mini-eye left"></view><view class="mini-eye right"></view></view></view><text>薄荷团 · 运动</text></button>
        <button class="quick-action" data-type="weight" bindtap="openModal"><view class="action-icon weight-action"><view class="mini-character kitty"><view class="mini-ear left"></view><view class="mini-ear right"></view><view class="mini-eye left"></view><view class="mini-eye right"></view></view></view><text>云朵猫 · 体重</text></button>
      </view>

      <view class="section-head"><view><view class="section-title">今天的小小成就</view><view class="section-subtitle">已经收集 {{logs.length}} 枚努力贴纸</view></view><view class="section-sticker soft">NICE</view></view>
      <view class="record-panel">
        <block wx:for="{{logs}}" wx:key="index">
          <view class="record-item">
            <view class="record-mark {{item.cls}}"><view class="record-dot"></view></view>
            <view class="record-copy"><view class="record-title">{{item.title}}</view><view class="record-time">{{item.time}}</view></view>
            <view class="record-value">{{item.amount}}</view>
          </view>
        </block>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeNav === 'trend'}}">
    <view class="trend-head">
      <view class="trend-heading"><view><view class="date-label">WEIGHT TREND · DAY 18</view><view class="page-title trend-title">看见每一点小变化</view></view><button class="circle-add" aria-label="记录体重" data-type="weight" bindtap="openModal">＋</button></view>
      <view class="trend-summary">比起 7 天前，你已经轻了 <text>{{trendLoss}} kg</text></view>
    </view>

    <view class="main-content trend-content">
      <view class="chart-panel">
        <view class="chart-topline"><view class="chart-overview"><view><view class="chart-label">最新体重</view><view class="chart-current {{weightTone}}">{{weight}} <text>kg</text></view></view><view class="chart-delta"><view class="delta-arrow">↓</view><view><view class="delta-value">{{trendLoss}} kg</view><view class="delta-label">本周期</view></view></view></view><view class="period-control"><button class="period-button {{trendPeriod === 'week' ? 'active' : ''}}" data-period="week" bindtap="switchPeriod">7天</button><button class="period-button {{trendPeriod === 'month' ? 'active' : ''}}" data-period="month" bindtap="switchPeriod">30天</button><button class="period-button {{trendPeriod === 'quarter' ? 'active' : ''}}" data-period="quarter" bindtap="switchPeriod">3个月</button></view></view>
        <view class="chart-area">
          <view class="grid-line grid-one"></view><view class="grid-line grid-two"></view><view class="grid-line grid-three"></view><view class="grid-line grid-four"></view>
          <block wx:for="{{chartSegments}}" wx:key="index"><view class="chart-segment" style="left:{{item.left}}%;top:{{item.top}}rpx;width:{{item.width}}%;transform:rotate({{item.angle}}deg);"></view></block>
          <block wx:for="{{chartPoints}}" wx:key="index"><view class="chart-point {{index === chartPoints.length - 1 ? 'latest' : ''}}" style="left:{{item.x}}%;top:{{item.y}}rpx;"><view wx:if="{{index === chartPoints.length - 1}}" class="point-bubble">{{weight}}</view></view></block>
        </view>
        <view class="chart-labels"><block wx:for="{{chartPoints}}" wx:key="index"><text>{{item.label}}</text></block></view>
      </view>

      <view class="trend-stats"><view class="trend-stat"><view class="stat-label">平均体重</view><view class="stat-number">59.0 <text>kg</text></view></view><view class="trend-stat"><view class="stat-label">最低体重</view><view class="stat-number">{{weight}} <text>kg</text></view></view><view class="trend-stat"><view class="stat-label">连续记录</view><view class="stat-number">7 <text>天</text></view></view></view>

      <view class="section-head trend-section"><view><view class="section-title">体重记录</view><view class="section-subtitle">规律记录，更容易看见变化</view></view></view>
      <view class="weight-history">
        <block wx:for="{{weightHistory}}" wx:key="date"><view class="history-row"><view class="history-date"><view class="history-day">{{item.day}}</view><view class="history-month">{{item.date}}</view></view><view class="history-line"><view class="history-dot"></view></view><view class="history-copy"><view class="history-weight">{{item.weight}} kg</view><view class="history-note">{{item.note}}</view></view><view class="history-change {{item.down ? 'down' : ''}}">{{item.change}}</view></view></block>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="page-head"><view><view class="date-label">MY KAWAII PLAN</view><view class="page-title">我的可爱变轻计划</view></view></view>
    <view class="main-content"><view class="profile-panel"><view class="profile-avatar"><view class="avatar-leaf large"></view></view><view class="profile-name">今天也很认真</view><view class="profile-copy">已经坚持记录 18 天</view><view class="profile-data"><view><text>3.4</text><label>已减 kg</label></view><view><text>18</text><label>坚持天数</label></view><view><text>54.0</text><label>目标 kg</label></view></view></view><view class="settings-panel"><button bindtap="actionToast" data-action="goal"><text>目标设置</text><text>›</text></button><button bindtap="actionToast" data-action="reminder"><text>记录提醒</text><text>›</text></button><button bindtap="actionToast" data-action="about"><text>关于这不得瘦死</text><text>›</text></button></view></view>
  </block>

  <view class="bottom-nav">
    <button class="nav-button {{activeNav === 'home' ? 'active' : ''}}" data-nav="home" bindtap="switchNav"><view class="nav-glyph home-glyph"></view><text>首页</text></button>
    <button class="nav-button {{activeNav === 'trend' ? 'active' : ''}}" data-nav="trend" bindtap="switchNav"><view class="nav-glyph chart-glyph"><view></view><view></view><view></view></view><text>趋势</text></button>
    <button class="nav-button {{activeNav === 'mine' ? 'active' : ''}}" data-nav="mine" bindtap="switchNav"><view class="nav-glyph user-glyph"></view><text>我的</text></button>
  </view>
</view>

<view wx:if="{{modalVisible}}" class="modal-backdrop" catchtap="closeModal">
  <view class="modal {{modalType === 'weight' ? 'weight-modal' : ''}}" catchtap="stopBubble">
    <view class="modal-head"><view><view class="modal-eyebrow">添加记录</view><view class="modal-title">{{modalTitle}}</view></view><button class="close-button" bindtap="closeModal">×</button></view>
    <block wx:if="{{modalType === 'weight'}}">
      <view class="weight-entry">
        <view class="weight-entry-label">滑动选择今天的体重</view>
        <view class="weight-picker-shell">
          <view class="picker-selection"></view>
          <picker-view class="weight-picker" value="{{weightPickerValue}}" indicator-style="height: 88rpx;" mask-style="background: linear-gradient(180deg, rgba(255,250,252,.98), rgba(255,250,252,0) 38%, rgba(255,250,252,0) 62%, rgba(255,250,252,.98));" bindchange="onWeightPickerChange">
            <picker-view-column>
              <view wx:for="{{weightWholeOptions}}" wx:key="*this" wx:for-item="whole" wx:for-index="wholeIndex" class="picker-item picker-whole {{weightPickerValue[0] === wholeIndex ? 'selected' : ''}}">{{whole}}</view>
            </picker-view-column>
            <picker-view-column>
              <view wx:for="{{weightDecimalOptions}}" wx:key="*this" wx:for-item="decimal" wx:for-index="decimalIndex" class="picker-item picker-decimal {{weightPickerValue[1] === decimalIndex ? 'selected' : ''}}">.{{decimal}}</view>
            </picker-view-column>
          </picker-view>
          <text class="picker-unit">kg</text>
        </view>
        <view class="weight-entry-tip">上下滑动数字，精确到 0.1 kg</view>
      </view>
    </block>
    <block wx:else>
      <view class="field"><view class="field-label">{{nameLabel}}</view><input class="field-input" placeholder="{{namePlaceholder}}" value="{{inputName}}" data-field="inputName" bindinput="onInput" /></view>
      <view class="field"><view class="field-label">{{amountLabel}}</view><view class="input-with-unit"><input class="field-input amount-input" type="digit" placeholder="{{amountPlaceholder}}" value="{{inputAmount}}" data-field="inputAmount" bindinput="onInput" /><text>{{inputUnit}}</text></view></view>
    </block>
    <view class="field"><view class="field-label">备注</view><input class="field-input" placeholder="写下今天的感受（选填）" value="{{inputNote}}" data-field="inputNote" bindinput="onInput" /></view>
    <button class="submit-button" bindtap="saveRecord">保存记录</button>
  </view>
</view>
